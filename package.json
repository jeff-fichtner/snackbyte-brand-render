{
  "name": "@snackbyte/brand",
  "version": "2.0.0",
  "description": "The snackbyte brand, compressed for code: tokens as CSS and TypeScript, the faces as self-hosted woff2, the marks as SVG, a favicon set. Generated from the guide.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./marks.json": "./dist/marks.json",
    "./dist/*": "./dist/*",
    "./fonts.css": "./dist/fonts.css",
    "./fonts/*": "./dist/fonts/*"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node src/build.mjs",
    "check:all": "node src/verify.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "fontkit": "^2.0.4",
    "snackbyte-brand": "github:jeff-fichtner/snackbyte-brand#v2.1.0",
    "subset-font": "^2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeff-fichtner/snackbyte-brand-render.git"
  }
}
